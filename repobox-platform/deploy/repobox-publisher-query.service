# /etc/systemd/system/repobox-publisher-query.service
# repo.box publisher query worker: answers runtime log/status queries for a
# publisher app's *current* container (docker logs/inspect only). Separate
# from the deploy worker so logs stay available during a long deploy.
[Unit]
Description=repo.box publisher runtime queries
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/srv/repobox-platform/bin/repobox-platform publisher-query
TimeoutStartSec=2min
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/spool/repobox-publisher
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
