# /etc/systemd/system/repobox-platform.service
# repo.box platform control plane: auth.repo.box UI + the loopback gate that
# Caddy consults (forward_auth) before serving any managed app, and the
# platform AI endpoint's control-plane hop.
#
# Runs as its own non-login system user `repobox-platform` (created by
# scripts/deploy.sh). The registry (/var/lib/repobox-platform, 0700/0600) and
# the AI bridge secret credential are readable only by that user, not by the
# app services that run as `fran`. Operators use /usr/local/bin/repobox-platform
# (root-only wrapper that runs the CLI as this user).
[Unit]
Description=repo.box platform control plane (auth.repo.box + edge gate)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=repobox-platform
Group=repobox-platform
UMask=0077
Environment=RUST_LOG=info
Environment=REPOBOX_PLATFORM_DB=/var/lib/repobox-platform/platform.db
# Bridge secret for the AI broker (root-owned 0600 source, installed by
# scripts/deploy-ai-bridge.sh). 127.0.0.1:3232 is the repo.box end of the
# private reverse tunnel to the broker on the ChatMock host.
LoadCredential=ai-bridge-secret:/etc/repobox-platform/ai-bridge.secret
ExecStart=/srv/repobox-platform/bin/repobox-platform serve --bind 127.0.0.1:3230 --public-base https://auth.repo.box --domain repo.box --ai-upstream http://127.0.0.1:3232
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/repobox-platform
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Loopback only: Caddy's hops in, the AI tunnel out. Nothing else.
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
