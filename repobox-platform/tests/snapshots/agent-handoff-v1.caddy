# GENERATED by `repobox-platform routes render`. Do not edit by hand.
# Every managed app: strip browser identity headers -> ask the control
# plane gate -> copy gate-issued identity -> serve. Visibility and
# enabled state are evaluated by the gate per request.
# gate: 127.0.0.1:3230
# managed apps: 1

# app: vibe-games (proxy -> 127.0.0.1:3218)
# identity: platform (gate-injected identity only; no app login)
vibe-games.repo.box {
	header {
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}
	route {
		request_header -X-RepoBox-*
		request_header -X-Fizmo-Anon-Capability
		request_header -X-Fizmo-Claim
		@agent_claim path /agent/h/*
		handle @agent_claim {
			header Referrer-Policy "no-referrer"
			header Cache-Control "no-store"
			header X-Robots-Tag "noindex"
			route {
			request_header -Cookie
			request_header -Authorization
			request_header -Referer
			request_header -X-Forwarded-Uri
			request_header X-Fizmo-Anon-Capability 1
			request_header X-Fizmo-Claim {http.request.uri.path}
			rewrite * /agent/h/claim
			reverse_proxy 127.0.0.1:3218
			}
		}
		@agent_handoff path /agent/guide.txt /agent/guide.json /api/handoff/v1/agent/status /api/handoff/v1/agent/draft
		handle @agent_handoff {
			header Referrer-Policy "no-referrer"
			header Cache-Control "no-store"
			header X-Robots-Tag "noindex"
			request_header -Cookie
			request_header -Authorization
			request_header -Referer
			request_header -X-Forwarded-Uri
			request_header X-Fizmo-Anon-Capability 1
			reverse_proxy 127.0.0.1:3218
		}
		handle {
			header Referrer-Policy "strict-origin-when-cross-origin"
		forward_auth 127.0.0.1:3230 {
			uri /gate/verify
			copy_headers X-RepoBox-User X-RepoBox-User-Id X-RepoBox-Role X-RepoBox-Auth X-RepoBox-App
			header_up X-RepoBox-Gate 1
			header_up X-RepoBox-Gate-App vibe-games
		}
		handle /_repo_box/ai/v1/* {
			uri replace /_repo_box/ai/ /gate/ai/ 1
			reverse_proxy 127.0.0.1:3230 {
				header_up X-RepoBox-Gate 1
				header_up X-RepoBox-Gate-App vibe-games
			}
		}
		handle /_repo_box/* {
			respond 404
		}
		handle {
			reverse_proxy 127.0.0.1:3218
		}
		}
	}
}
